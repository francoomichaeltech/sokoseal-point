# Meta Model API Configuration (Server-side only)
# Copy this file to .env.local and paste your Meta Model API key:
#   cp .env.example .env.local
#
# IMPORTANT: Never prefix MODEL_API_KEY with NEXT_PUBLIC_ and never commit .env.local.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Meta Model IDs (verified against GET /v1/models)
META_INTENT_MODEL=muse-spark-1.3
META_SEGMENT_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0
